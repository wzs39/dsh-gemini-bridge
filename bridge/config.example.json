{
  "upstream": {
    "origin": "https://gemini.google.com",
    "appPath": "/app",
    "batchExecutePath": "/_/BardChatUi/data/batchexecute",
    "rpcid": "entertg"
  },
  "browser": {
    "executable": null,
    "headless": false,
    "port": 9334,
    "args": [
      "--window-position=-32000,-32000",
      "--disable-backgrounding-occluded-windows",
      "--disable-renderer-backgrounding",
      "--disable-background-timer-throttling"
    ],
    "userDataDir": null
  },
  "accounts": [
    { "name": "default", "label": "Google 账号（单用户可只留一个）" }
  ],
  "server": {
    "host": "127.0.0.1",
    "port": 18901,
    "apiKey": "sk-local-gemini-web",
    "model": "gemini-web"
  },
  "agy": {
    "enabled": true,
    "project": "aicode-consumers",
    "defaultModel": "gemini-3.8-flash-medium",
    "tokenFile": null,
    "poolFile": null
  },
  "behaviour": {
    "keepAliveSeconds": 900,
    "completionTimeoutMs": 1800000,
    "streamIdleTimeoutMs": 120000,
    "tokenTtlMs": 3600000,
    "emptyRetries": 1
  },
  "protection": {
    "preset": "balanced",
    "_comment": "preset 是 cautious | balanced | brisk 三档之一。显式写下面的数字会覆盖 preset 的同名字段；不写就用 preset 的值。/health 的 pacingPreset 和 dailyCeiling 会告诉你实际生效的是什么。"
  },
  "debug": {
    "capture": false
  }
}
